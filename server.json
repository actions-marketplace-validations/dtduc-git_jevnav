{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dtduc-git/jevnav",
  "description": "Replayable browser automation: Jev picks the element, a gate blocks risky actions, every run traces.",
  "title": "jevnav",
  "websiteUrl": "https://github.com/dtduc-git/jevnav",
  "repository": {
    "url": "https://github.com/dtduc-git/jevnav",
    "source": "github"
  },
      "version": "0.1.9",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "jevnav",
  "version": "0.1.9",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "TYPESAFE_API_KEY",
          "description": "TypeSafe API key for Jev decisions (optional if ~/.config/typesafe/apikey.txt exists)",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
